  },
  "dependencies": {
    "@stream-io/node-sdk": "^0.9.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.5",
    "firebase": "^12.19.0",
    "typescript": "~6.0.3"
  }
}
