# Copy to `.env` and fill in. Never commit `.env`.

# Paths to the Firebase native config files (defaults shown).
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist

# Google Maps SDK keys.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Public Stream Video API key. The secret goes in Firebase:
#   firebase functions:secrets:set STREAM_API_KEY
#   firebase functions:secrets:set STREAM_API_SECRET
EXPO_PUBLIC_STREAM_API_KEY=

# Optional: use the local Firebase emulators (e2e tests). `10.0.2.2` from an Android emulator.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
